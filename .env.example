# Supabase (https://app.supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública de la app (usada como redirectTo del login OAuth)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Modo demo SOLO para desarrollo local sin Supabase configurado.
# Debe quedar en "false" (o ausente) en cualquier entorno público/producción:
# activarlo simula una sesión de usuario sin backend real.
NEXT_PUBLIC_USE_MOCK_AUTH=false
